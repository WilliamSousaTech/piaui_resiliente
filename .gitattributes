# Fim de linha fixo em LF, em qualquer sistema (Windows incluso).
# Motivo: o SHA-256 do params.yaml (manifest) e o dos CSVs de referencia (selo) mudam se o Git
# converter LF em CRLF no checkout. Teste: tests/test_gitattributes.py.
* text=auto eol=lf

*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.geojson text eol=lf
*.csv     text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf

# Binarios: nunca converter fim de linha
*.parquet binary
*.zip     binary
*.pdf     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.ico     binary
*.xlsx    binary
*.npy     binary
*.npz     binary
*.pkl     binary
*.joblib  binary
*.pt      binary
*.pth     binary
*.onnx    binary
